# Copy to .env.local for local development, and set the same two variables in
# your Vercel project (Settings -> Environment Variables, all environments).
#
# Both values are PUBLIC by design: the publishable key carries no privileges of
# its own, and every table it can reach is guarded by row-level security. That is
# why they are NEXT_PUBLIC_ and end up in the browser bundle.
#
# The project's SECRET key (sb_secret_...) bypasses row-level security entirely.
# It must never appear in this file, in a NEXT_PUBLIC_ variable, or in the repo.

NEXT_PUBLIC_SUPABASE_URL=https://fprfnbfoqjuwgckhtnxz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jBj9tm1s4C4uUCa8QijiMw_OiKpLbmr
